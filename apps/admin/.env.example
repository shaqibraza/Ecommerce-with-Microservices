# Clerk — https://dashboard.clerk.com → API Keys
# Admin users must have metadata.role = "admin" in Clerk session claims
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Backend service URLs (local development defaults)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_PRODUCT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_ORDER_SERVICE_URL=http://localhost:8001

# Cloudinary — https://cloudinary.com/console
# Create an unsigned upload preset named "ecommerce" for product images
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
